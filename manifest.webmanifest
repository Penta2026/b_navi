{
  "name": "B_Navi | スマホPWA",
  "short_name": "B_Navi",
  "description": "B_Navi バイク向けルート検索・音声案内・地域別オフライン地図",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "lang": "ja",
  "background_color": "#eef3f4",
  "theme_color": "#102a3b",
  "icons": [
    {
      "src": "./icon-192.png?v=pop-icon-20261124",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png?v=pop-icon-20261124",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./share-gpx",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "gpx",
          "accept": [
            ".gpx",
            "application/gpx+xml",
            "application/xml",
            "text/xml"
          ]
        }
      ]
    }
  }
}
